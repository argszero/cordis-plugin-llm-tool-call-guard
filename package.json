{
  "name": "@argszero/cordis-plugin-llm-tool-call-guard",
  "description": "Runaway tool-call argument guard for dsh: wrap the llm/stream waterfall and cut a tool call that streams more than a configurable number of arguments bytes, terminating with a routed TOOL_CALL_ARGUMENTS_TOO_LARGE error finish so the oversized call is never executed. Compatible with dsh 0.1.5-alpha.1 (agent loop never executes a tool-call when the stream ends on an error/aborted finish).",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "llm",
    "stream",
    "tool-call",
    "runaway",
    "guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@types/node": "^26.5.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"test/*.test.js\"",
    "prepublishOnly": "tsc"
  }
}
